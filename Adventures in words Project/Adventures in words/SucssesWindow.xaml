<Window x:Class="Adventures_in_words.SucssesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Adventures_in_words"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="SucssesWindow" Height="310" Width="310">
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="CustomButtonStyle" TargetType="Button">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="#b9502e" Opacity="1">
        <Image Source="Resources\endlvl.png" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center"></Image>
        <Button x:Name="btnclose" Height="70" Width="180" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,35,0,50" BorderThickness="0" Style="{StaticResource CustomButtonStyle}" Click="btnclose_Click">
            <Button.Background>
                <ImageBrush ImageSource="Resources/Backmeny.png" Stretch="Fill"/>
            </Button.Background>
        </Button>
    </Grid>
</Window>
