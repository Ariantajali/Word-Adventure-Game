<Window x:Class="Adventures_in_words.Level1_g1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Adventures_in_words"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="Level1_g1" Height="650" Width="350">
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="CustomButtonStyle" TargetType="Button">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="wordF" TargetType="Button" BasedOn="{StaticResource CustomButtonStyle}">
                <Setter Property="Background">
                    <Setter.Value>
                        <ImageBrush ImageSource="Resources\Game1\wordoff.png" Stretch="Fill"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="FontFamily">
                    <Setter.Value>
                        <FontFamily>pack://application:,,,/Adventures in words;component/Resources/Ramollah_MRT.ttf#MRT_Ramollah</FontFamily>
                    </Setter.Value>
                </Setter>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                   Foreground="White" FontSize="35" VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WordT" TargetType="Button" BasedOn="{StaticResource wordF}">
                <Setter Property="Background">
                    <Setter.Value>
                        <ImageBrush ImageSource="Resources\Game1\wordon.png" Stretch="Fill"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CustomButtonStyleCoin" TargetType="Button" BasedOn="{StaticResource wordF}">
                <Setter Property="Background">
                    <Setter.Value>
                        <ImageBrush ImageSource="Resources/MO1.png" Stretch="Fill"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                   Foreground="White" FontSize="25" VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CustomButtonStyleWordfull" TargetType="Button" BasedOn="{StaticResource wordF}">
                <Setter Property="Background">
                    <Setter.Value>
                        <ImageBrush ImageSource="Resources\Game1\wordfull.png" Stretch="Fill"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                   Foreground="White" FontSize="30" VerticalAlignment="Center" >
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CustomButtonStyleWordfullfalse" TargetType="Button" BasedOn="{StaticResource CustomButtonStyleWordfull}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                   Foreground="Red" FontSize="30" VerticalAlignment="Center" >
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CustomButtonStyleWordfullTrue" TargetType="Button" BasedOn="{StaticResource CustomButtonStyleWordfull}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                   Foreground="LawnGreen" FontSize="30" VerticalAlignment="Center" >
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Word" TargetType="Button" BasedOn="{StaticResource wordF}">
                <Setter Property="Background">
                    <Setter.Value>
                        <ImageBrush ImageSource="Resources\Game1\word.png" Stretch="Fill"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                   Foreground="White" FontSize="25" VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Resources/Backgr.png" Stretch="UniformToFill"/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Border Grid.Column="0" Height="80" Width="320" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="15,15,15,0">
                <DockPanel>
                    <Button Name="BtnSetting" Height="50" Width="50" HorizontalAlignment="Left" Margin="10,0,0,0" BorderThickness="0" Style="{StaticResource CustomButtonStyle}" Click="BtnSetting_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="Resources/btnsetting.png" Stretch="Fill"/>
                        </Button.Background>
                    </Button>
                    <DockPanel Visibility="Collapsed" Name="Dock1">
                        <Button Name="Btnhome" Height="40" Width="40" HorizontalAlignment="Left" Margin="5,0,0,0" BorderThickness="0" Style="{StaticResource CustomButtonStyle}" Click="Btnhome_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="Resources/Btnhome.png" Stretch="Fill"/>
                            </Button.Background>
                        </Button>
                    </DockPanel>
                    <Button Name="btncoin" Width="110" Height="40" HorizontalAlignment="Right" BorderThickness="0" Margin="0,0,10,0" Style="{StaticResource CustomButtonStyleCoin}" >
                    </Button>

                </DockPanel>
            </Border>
            <Border Grid.Column="1" Width="320" Height="230" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="15,5,15,0">
                <StackPanel>
                <DockPanel Margin="0,15,0,0">
                        <Button Name="wrd1_2" Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Stretch" BorderThickness="0" Margin="70,0,0,0" Style="{StaticResource wordF}">
                        </Button>
                        <Button Name="wrd1_1" Width="80" Height="80" HorizontalAlignment="Right" VerticalAlignment="Stretch" BorderThickness="0" Margin="0,0,90,0" Style="{StaticResource wordF}">
                        </Button>
                </DockPanel>
                    <DockPanel>
                        <Button Name="wrd2_2" Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Stretch" BorderThickness="0" Margin="70,0,0,0" Style="{StaticResource wordF}">
                        </Button>
                        <Button Name="wrd2_1" Width="80" Height="80" HorizontalAlignment="Right" VerticalAlignment="Stretch" BorderThickness="0" Margin="0,0,90,0" Style="{StaticResource wordF}">
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Width="320" Height="290" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,5,15,0">
                <Border.Background>
                    <ImageBrush ImageSource="Resources\backwood.png" Stretch="Fill"/>
                </Border.Background>
                <StackPanel>
                    <DockPanel>
                        <Button Name="btngiuld" Width="50" Height="50" BorderThickness="0" HorizontalAlignment="Left" Margin="25,30,0,0" Style="{StaticResource CustomButtonStyle}" Click="btngiuld_Click" >
                            <Button.Background>
                                <ImageBrush ImageSource="Resources\Game1\guidance.png" Stretch="Fill"/>
                            </Button.Background>
                        </Button>
                        <Button Name="wordfull" Width="150" Height="60" BorderThickness="0" HorizontalAlignment="Stretch" Style="{StaticResource CustomButtonStyleWordfull}" Margin="10,0,0,20">
                        </Button>
                        <Button Name="btnRotation" Width="50" Height="50" BorderThickness="0" HorizontalAlignment="Right" Margin="0,30,25,0" Style="{StaticResource CustomButtonStyle}" Click="btnRotation_Click" >
                            <Button.Background>
                                <ImageBrush ImageSource="Resources\Game1\Rotation.png" Stretch="Fill"/>
                            </Button.Background>
                        </Button>
                    </DockPanel>
                    <Button Name="wrd1" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Stretch" BorderThickness="0" Margin="80,0,80,0" Style="{StaticResource Word}" Click="wrd1_Click">
                    </Button>
                    <DockPanel>
                        <Button Name="wrd2" Width="60" Height="60" HorizontalAlignment="Left" VerticalAlignment="Stretch" BorderThickness="0" Margin="45,0,0,0"  Style="{StaticResource Word}" Click="wrd2_Click">
                        </Button>
                        <Button Name="wrd3" Width="60" Height="60" HorizontalAlignment="Right" VerticalAlignment="Stretch" BorderThickness="0" Margin="0,0,45,0"  Style="{StaticResource Word}" Click="wrd3_Click">
                        </Button>
                    </DockPanel>
                    <Button Name="wrd4" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Stretch" BorderThickness="0" Margin="0,0,0,15"  Style="{StaticResource Word}" Click="wrd4_Click">
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
