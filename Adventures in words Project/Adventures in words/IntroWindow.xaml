<Window x:Class="Adventures_in_words.IntroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Adventures_in_words"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="IntroWindow" Height="650" Width="350"
        Icon="Resources/Logo_Game.ico">

    <Grid Background="#945bfe">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="Border1" Grid.Column="0" Width="350" Height="400" HorizontalAlignment="Center">
            <Image x:Name="img1" Source="Resources/IntroLogo.png" HorizontalAlignment="Stretch" Opacity="0" ></Image>
        </Border>
    </Grid>
</Window>
